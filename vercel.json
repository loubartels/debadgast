{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 tools/bouw.py",
  "outputDirectory": ".",
  "framework": null,
  "redirects": [
    {
      "source": "/startpagina",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wiebenik",
      "destination": "/#over",
      "permanent": true
    },
    {
      "source": "/werkwijze",
      "destination": "/#werkwijze",
      "permanent": true
    },
    {
      "source": "/praktijk",
      "destination": "/#diensten",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#offerte",
      "permanent": true
    },
    {
      "source": "/algemenevoorwaarden",
      "destination": "/voorwaarden.html",
      "permanent": true
    },
    {
      "source": "/recensies",
      "destination": "/recensies.html",
      "permanent": true
    },
    {
      "source": "/fotos",
      "destination": "/#projecten",
      "permanent": true
    },
    {
      "source": "/fotos/:pad*",
      "destination": "/#projecten",
      "permanent": true
    },
    {
      "source": "/algemenevoorwaarden/",
      "destination": "/voorwaarden.html",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/privacyverklaring",
      "destination": "/privacy.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formsubmit.co; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
